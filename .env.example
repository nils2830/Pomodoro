# ─────────────────────────────────────────────────────────────
# Steen environment variables
# Everything is optional. With nothing set, Steen runs in
# "local mode": all data lives in the browser, no accounts and
# no sign-in wall. Set the Supabase values to require accounts.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployment (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allow a local "demo Pro" switch when billing is not configured.
# Handy while developing. Set to false in production.
NEXT_PUBLIC_ALLOW_DEMO_PRO=true

# Who runs the site (shown on /terms and /privacy and in the footer)
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_COUNTRY=Denmark
NEXT_PUBLIC_CONTACT_EMAIL=

# Server only. Comma-separated emails that can open /admin and give Pro.
ADMIN_EMAILS=

# ── Supabase (accounts + saved data) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the Stripe webhook, admin and account deletion.
SUPABASE_SERVICE_ROLE_KEY=
# Build only. Direct database URL; `npm run build` applies
# supabase/migrations with it. Vercel's Supabase integration sets it.
POSTGRES_URL_NON_POOLING=

# ── Stripe (Pro subscriptions) ───────────────────────────────
# Publishable key (pk_test_… / pk_live_…) for the embedded checkout form
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Set to true once the keys above are filled in
NEXT_PUBLIC_BILLING_ENABLED=false
