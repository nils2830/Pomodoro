# ─────────────────────────────────────────────────────────────
# Cadence environment variables
# Everything is optional. With nothing set, Cadence runs in
# "local mode": all data lives in the browser, no accounts.
# ─────────────────────────────────────────────────────────────

# Public URL of the deployment (used for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Allow a local "demo Pro" switch when billing is not configured.
# Handy while developing. Set to false in production.
NEXT_PUBLIC_ALLOW_DEMO_PRO=true

# ── Supabase (accounts + cloud sync) ─────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by the Stripe webhook to update plans.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (Pro subscriptions) ───────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
# Set to true once the keys above are filled in
NEXT_PUBLIC_BILLING_ENABLED=false
