    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource-variable/host-grotesk": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lenis": "^1.3.27",
    "motion": "^14.5.0",
    "next": "^16.4.2",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "stripe": "^23.0.0",
    "zustand": "^5.0.15"
